#!/usr/bin/env bash
# Test double for the aws CLI (scripts/infra/test/run.sh puts this directory first on PATH). It never reaches AWS.
# State lives in $STUB_DIR: get.json (get-distribution-config reply), stack-<OutputKey> (describe-stacks outputs),
# secret (secretsmanager value), rhp.json (custom response headers policies: [{Id, ETag, Config}], absent = none),
# fn-DEVELOPMENT.js / fn-LIVE.js (the code of the CloudFront Function fn-name, default HFYAppendIndex; absent stage = no such
# function), fn-etag (its DEVELOPMENT ETag, default EFN-1), fn-runtime (default cloudfront-js-1.0).
# bucket-policy.json (the bucket policy, absent = NoSuchBucketPolicy; put/delete-bucket-policy change it), account (sts, default 123456789012).
# iam simulate-custom-policy models the Deny/Allow evaluation of a resource policy plus one identity policy in python (explicitDeny, allowed, implicitDeny).
# Every call is appended to calls.log; each update-distribution payload is saved as update-<n>.json.
set -euo pipefail
: "${STUB_DIR:?STUB_DIR not set}"
printf '%s\n' "$*" >> "$STUB_DIR/calls.log"
RHP_DB="$STUB_DIR/rhp.json"
rhp_db() { if [ -f "$RHP_DB" ]; then cat "$RHP_DB"; else echo '[]'; fi; }
arg() { # NAME ARGS... -> value of --NAME
  local n=$1; shift
  while [ $# -gt 0 ]; do if [ "$1" = "--$n" ]; then printf '%s' "$2"; return 0; fi; shift; done
  return 1
}
fn_etag() { if [ -f "$STUB_DIR/fn-etag" ]; then cat "$STUB_DIR/fn-etag"; else echo EFN-1; fi; }
fn_bump_etag() { printf 'EFN-%s\n' "$(( $(fn_etag | sed 's/^EFN-//') + 1 ))" > "$STUB_DIR/fn-etag"; }
fn_exists() { [ "$1" = "$(cat "$STUB_DIR/fn-name" 2>/dev/null || echo HFYAppendIndex)" ] && [ -f "$STUB_DIR/fn-$2.js" ]; }
fn_summary() { # NAME STAGE
  jq -n --arg n "$1" --arg s "$2" --arg rt "$(cat "$STUB_DIR/fn-runtime" 2>/dev/null || echo cloudfront-js-1.0)" --arg c "$(cat "$STUB_DIR/fn-comment" 2>/dev/null || echo 'Append index.html to directory paths')" \
    '{Name: $n, Status: "DEPLOYED", FunctionConfig: {Comment: $c, Runtime: $rt}, FunctionMetadata: {FunctionARN: "arn:aws:cloudfront::123456789012:function/\($n)", Stage: $s}}'
}
case "$1 $2" in
  "cloudfront get-distribution-config") cat "$STUB_DIR/get.json" ;;
  "cloudfront update-distribution")
    cfg=""; etag=""
    while [ $# -gt 0 ]; do case "$1" in --distribution-config) cfg=${2#file://}; shift;; --if-match) etag=$2; shift;; esac; shift; done
    n=$(( $(find "$STUB_DIR" -maxdepth 1 -name 'update-*.json' | wc -l) + 1 ))
    cp "$cfg" "$STUB_DIR/update-$n.json"; printf '%s\n' "$etag" > "$STUB_DIR/update-$n.etag"
    echo InProgress ;;
  "cloudfront list-response-headers-policies")
    [ "$(arg type "$@")" = custom ] || { echo "aws stub: expected --type custom" >&2; exit 98; }
    rhp_db | jq '{ResponseHeadersPolicyList: {MaxItems: 100, Quantity: length,
      Items: map({Type: "custom", ResponseHeadersPolicy: {Id, LastModifiedTime: "2026-10-01T00:00:00Z", ResponseHeadersPolicyConfig: .Config}})}}' ;;
  "cloudfront create-response-headers-policy")
    cfg=$(arg response-headers-policy-config "$@"); cfg=${cfg#file://}
    if rhp_db | jq -e --slurpfile c "$cfg" 'any(.[]; .Config.Name == $c[0].Name)' >/dev/null; then
      echo "ResponseHeadersPolicyAlreadyExists" >&2; exit 254
    fi
    id="aaaaaaaa-0000-4000-8000-$(printf '%012d' $(( $(rhp_db | jq length) + 1 )))"
    rhp_db | jq --arg id "$id" --slurpfile c "$cfg" '. + [{Id: $id, ETag: "E-RHP-1", Config: $c[0]}]' > "$RHP_DB.new" && mv "$RHP_DB.new" "$RHP_DB"
    jq -n --arg id "$id" --slurpfile c "$cfg" '{ETag: "E-RHP-1", ResponseHeadersPolicy: {Id: $id, ResponseHeadersPolicyConfig: $c[0]}}' ;;
  "cloudfront get-response-headers-policy-config")
    id=$(arg id "$@")
    rhp_db | jq -e --arg id "$id" 'map(select(.Id == $id)) | first | {ETag, ResponseHeadersPolicyConfig: .Config}' \
      || { echo "NoSuchResponseHeadersPolicy" >&2; exit 254; } ;;
  "cloudfront update-response-headers-policy")
    id=$(arg id "$@"); etag=$(arg if-match "$@"); cfg=$(arg response-headers-policy-config "$@"); cfg=${cfg#file://}
    cur=$(rhp_db | jq -r --arg id "$id" 'map(select(.Id == $id)) | first | .ETag // empty')
    [ -n "$cur" ] || { echo "NoSuchResponseHeadersPolicy" >&2; exit 254; }
    [ "$cur" = "$etag" ] || { echo "PreconditionFailed" >&2; exit 254; }
    printf '%s\n' "$id" >> "$STUB_DIR/rhp-updates.log"
    rhp_db | jq --arg id "$id" --slurpfile c "$cfg" 'map(if .Id == $id then .Config = $c[0] | .ETag = "E-RHP-\((.ETag | ltrimstr("E-RHP-") | tonumber) + 1)" else . end)' > "$RHP_DB.new" && mv "$RHP_DB.new" "$RHP_DB"
    jq -n --arg id "$id" --slurpfile c "$cfg" '{ResponseHeadersPolicy: {Id: $id, ResponseHeadersPolicyConfig: $c[0]}}' ;;
  "cloudfront describe-function")
    name=$(arg name "$@"); stage=$(arg stage "$@" || echo DEVELOPMENT)
    fn_exists "$name" "$stage" || { echo "An error occurred (NoSuchFunctionExists) when calling the DescribeFunction operation: The specified function does not exist." >&2; exit 254; }
    fn_summary "$name" "$stage" | jq --arg e "$(fn_etag)" '{ETag: $e, FunctionSummary: .}' ;;
  "cloudfront get-function")
    name=$(arg name "$@"); stage=$(arg stage "$@" || echo DEVELOPMENT)
    fn_exists "$name" "$stage" || { echo "An error occurred (NoSuchFunctionExists) when calling the GetFunction operation: The specified function does not exist." >&2; exit 254; }
    cp "$STUB_DIR/fn-$stage.js" "${!#}"; jq -n --arg e "$(fn_etag)" '{ETag: $e, ContentType: "application/octet-stream"}' ;;
  "cloudfront update-function")
    name=$(arg name "$@"); etag=$(arg if-match "$@"); cfg=$(arg function-config "$@"); code=$(arg function-code "$@"); code=${code#fileb://}
    fn_exists "$name" DEVELOPMENT || { echo "NoSuchFunctionExists" >&2; exit 254; }
    [ "$etag" = "$(fn_etag)" ] || { echo "An error occurred (PreconditionFailed) when calling the UpdateFunction operation" >&2; exit 254; }
    runtime=$(jq -r .Runtime <<<"$cfg"); printf '%s' "$runtime" > "$STUB_DIR/fn-runtime"; jq -r .Comment <<<"$cfg" > "$STUB_DIR/fn-comment"
    cp "$code" "$STUB_DIR/fn-DEVELOPMENT.js"; fn_bump_etag
    fn_summary "$name" DEVELOPMENT | jq --arg e "$(fn_etag)" '{ETag: $e, FunctionSummary: .}' ;;
  "cloudfront test-function")
    name=$(arg name "$@"); etag=$(arg if-match "$@"); stage=$(arg stage "$@"); ev=$(arg event-object "$@"); ev=${ev#fileb://}
    fn_exists "$name" "$stage" || { echo "NoSuchFunctionExists" >&2; exit 254; }
    [ "$etag" = "$(fn_etag)" ] || { echo "An error occurred (PreconditionFailed) when calling the TestFunction operation" >&2; exit 254; }
    # Stands in for the cloudfront-js-1.0 runtime: runs the stage's code on the event in a bare V8 context.
    node -e '
      const vm = require("vm"), fs = require("fs");
      let out = "", err = "";
      try {
        const ctx = vm.createContext({});
        vm.runInContext(fs.readFileSync(process.argv[1], "utf8"), ctx);
        const r = vm.runInContext("handler", ctx)(JSON.parse(fs.readFileSync(process.argv[2], "utf8")));
        out = JSON.stringify(r.statusCode !== undefined ? { response: r } : { request: r });
      } catch (e) { err = String(e); }
      console.log(JSON.stringify({ TestResult: { FunctionSummary: {}, ComputeUtilization: "1", FunctionExecutionLogs: [], FunctionErrorMessage: err, FunctionOutput: out } }));
    ' "$STUB_DIR/fn-$stage.js" "$ev" ;;
  "cloudfront publish-function")
    name=$(arg name "$@"); etag=$(arg if-match "$@")
    fn_exists "$name" DEVELOPMENT || { echo "NoSuchFunctionExists" >&2; exit 254; }
    [ "$etag" = "$(fn_etag)" ] || { echo "An error occurred (PreconditionFailed) when calling the PublishFunction operation" >&2; exit 254; }
    cp "$STUB_DIR/fn-DEVELOPMENT.js" "$STUB_DIR/fn-LIVE.js"; echo LIVE ;;
  "cloudformation describe-stacks")
    key=$(printf '%s\n' "$*" | sed -nE "s/.*OutputKey=='([A-Za-z0-9]+)'.*/\1/p")
    if [ -f "$STUB_DIR/stack-$key" ]; then cat "$STUB_DIR/stack-$key"; else echo None; fi ;;
  "secretsmanager get-secret-value")
    if [ -f "$STUB_DIR/secret" ]; then cat "$STUB_DIR/secret"; else echo "ResourceNotFoundException" >&2; exit 254; fi ;;
  "sts get-caller-identity") cat "$STUB_DIR/account" 2>/dev/null || echo 123456789012 ;;
  "s3api get-bucket-policy")
    if [ -f "$STUB_DIR/bucket-policy.json" ]; then jq -c . "$STUB_DIR/bucket-policy.json"
    else echo "An error occurred (NoSuchBucketPolicy) when calling the GetBucketPolicy operation: The bucket policy does not exist" >&2; exit 254; fi ;;
  "s3api put-bucket-policy")
    pol=$(arg policy "$@"); cp "${pol#file://}" "$STUB_DIR/bucket-policy.json"; printf 'put %s\n' "$(arg bucket "$@")" >> "$STUB_DIR/policy-writes.log" ;;
  "s3api delete-bucket-policy") rm -f "$STUB_DIR/bucket-policy.json"; printf 'delete %s\n' "$(arg bucket "$@")" >> "$STUB_DIR/policy-writes.log" ;;
  "iam simulate-custom-policy")
    python3 - "$(arg policy-input-list "$@")" "$(arg resource-policy "$@")" "$(arg caller-arn "$@")" "$(arg action-names "$@")" "$(arg resource-arns "$@")" <<'PY'
import fnmatch, json, sys
ident, rpol, caller, action, res = sys.argv[1:6]
load = lambda f: json.loads(f) if f.lstrip().startswith("{") else json.load(open(f[len("file://"):]))
as_list = lambda v: v if isinstance(v, list) else [v]
def match(pats, v): return any(fnmatch.fnmatchcase(v, p) for p in as_list(pats))
def stmts(doc): return as_list(doc.get("Statement", []))
decision = "implicitDeny"
for st in stmts(load(ident)):
    if st["Effect"] == "Allow" and match(st["Action"], action) and match(st["Resource"], res): decision = "allowed"
for st in stmts(load(rpol)):
    if st["Effect"] != "Deny" or not match(st["Action"], action) or not match(st["Resource"], res): continue
    cond = st.get("Condition", {})
    hit = True
    for op, kv in cond.items():
        for key, pats in kv.items():
            if key != "aws:PrincipalArn": print("stub: unmodelled condition key " + key, file=sys.stderr); sys.exit(97)
            m = match(pats, caller)
            if op == "ArnNotLike": hit = hit and not m
            elif op == "ArnLike": hit = hit and m
            else: print("stub: unmodelled operator " + op, file=sys.stderr); sys.exit(97)
    if hit: decision = "explicitDeny"
print(decision)
PY
    ;;
  *) echo "aws stub: unexpected call: $*" >&2; exit 99 ;;
esac
