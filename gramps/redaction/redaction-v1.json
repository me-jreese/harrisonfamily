{
  "$schema": "./redaction-v1.schema.json",
  "policy": "redaction-v1",
  "version": 1,
  "title": "Redaction policy v1: what never goes to the cloud",
  "basis": [
    "sync.md section 5, as amended by BRD2 section 11.1",
    "BRD2 D2-32, Q2-02 and Q2-18",
    "review findings PS-01, PS-02, PS-03, PS-06, PS-15, SI-16 and SI-19"
  ],
  "phases": [
    { "id": "classify", "order": 1, "summary": "Decide which primary objects are excluded or held, from their own flags, types and files. No other object is needed." },
    { "id": "elements", "order": 2, "summary": "Remove private secondary elements from each kept object." },
    { "id": "fields", "order": 3, "summary": "Reduce dates, blank local-only fields and round coordinates on each kept object." },
    { "id": "scan", "order": 4, "summary": "Scan the outgoing free text. A hit holds a field of an object the cloud already has, or the whole object when it is new." },
    { "id": "orphans", "order": 5, "summary": "Exclude, until nothing more changes, every object that only excluded or held objects reference." },
    { "id": "references", "order": 6, "summary": "Filter references to excluded or held objects, and re-point places." }
  ],
  "birthLike": {
    "summary": "The one list of birth-like events. The projection, the server validator, the edit guard and the renderer import this predicate; nobody keeps a local list (D2-32).",
    "eventTypes": [
      { "value": 12, "name": "Birth" },
      { "value": 14, "name": "Adult Christening" },
      { "value": 15, "name": "Baptism" },
      { "value": 18, "name": "Bless" },
      { "value": 22, "name": "Christen" },
      { "value": 45, "name": "Stillbirth" }
    ],
    "customType": {
      "value": 0,
      "pattern": "birth|bapt|christen|naissance|geburt|nacimiento",
      "flags": "i"
    },
    "birthRefIndex": true,
    "appliesTo": "everyone, living or deceased"
  },
  "dates": {
    "dayMonthIndexes": [0, 1, 4, 5],
    "yearIndexes": [2, 6],
    "bareYearTextPattern": "^[0-9]{1,4}$",
    "textOnlyModifier": 6,
    "textOnlyYearPattern": "(?:^|[^0-9])([0-9]{4})(?![0-9])",
    "sortvalCalendars": [0, 1],
    "nameTypeBirth": 2
  },
  "attributes": {
    "ageAndTime": [
      { "value": 10, "name": "Age" },
      { "value": 11, "name": "Father Age" },
      { "value": 12, "name": "Mother Age" },
      { "value": 14, "name": "Time" }
    ],
    "governmentId": [
      { "value": 6, "name": "Social Security Number" },
      { "value": 3, "name": "Identification Number" }
    ]
  },
  "urls": {
    "emailType": 1,
    "schemes": ["mailto", "tel", "sms", "callto", "facetime", "skype", "whatsapp"],
    "hosts": ["m.me", "ig.me", "wa.me", "t.me", "telegram.me", "messenger.com", "api.whatsapp.com", "signal.me"],
    "paths": [{ "host": "instagram.com", "prefix": "/m/" }]
  },
  "places": {
    "excludedTypes": [
      { "value": 7, "name": "Street" },
      { "value": 18, "name": "Farm" },
      { "value": 19, "name": "Building" },
      { "value": 20, "name": "Number" }
    ],
    "customHomeLike": {
      "value": 0,
      "pattern": "house|home|residence|address|apartment|apt|lot|farm",
      "flags": "i"
    },
    "administrativeTypes": [
      { "value": 1, "name": "Country" },
      { "value": 2, "name": "State" },
      { "value": 3, "name": "County" },
      { "value": 8, "name": "Province" },
      { "value": 9, "name": "Region" },
      { "value": 10, "name": "Department" }
    ],
    "locationFields": ["street", "locality", "postal", "phone"],
    "coordinateDecimals": 2,
    "coordinatePattern": "^[+-]?[0-9]+(\\.[0-9]+)?$"
  },
  "media": {
    "heldMime": ["application/pdf"],
    "exifGpsMime": ["image/jpeg", "image/png", "image/tiff"],
    "rectRange": [0, 100],
    "fullFrameRect": [0, 0, 100, 100]
  },
  "scan": {
    "kinds": ["phone", "email", "street_address", "po_box", "contact_url", "dob_heuristic"],
    "desktopOnlyKinds": ["dob_exact"],
    "dobWindow": 60,
    "fields": [
      { "class": "Note", "path": "/text/string" },
      { "class": "Event", "path": "/description" },
      { "class": "Media", "path": "/desc" },
      { "class": "Attribute", "path": "/value" },
      { "class": "SrcAttribute", "path": "/value" },
      { "class": "Url", "path": "/desc" },
      { "class": "Url", "path": "/path" },
      { "class": "Citation", "path": "/page" },
      { "class": "Source", "path": "/title" },
      { "class": "Source", "path": "/author" },
      { "class": "Source", "path": "/pubinfo" },
      { "class": "Source", "path": "/abbrev" },
      { "class": "Repository", "path": "/name" },
      { "class": "PersonRef", "path": "/rel" },
      { "class": "Name", "path": "/first_name" },
      { "class": "Name", "path": "/call" },
      { "class": "Name", "path": "/nick" },
      { "class": "Name", "path": "/famnick" },
      { "class": "Name", "path": "/title" },
      { "class": "Name", "path": "/suffix" },
      { "class": "Surname", "path": "/surname" },
      { "class": "PlaceName", "path": "/value" },
      { "class": "Place", "path": "/title" },
      { "class": "Place", "path": "/code" },
      { "class": "Tag", "path": "/name" }
    ]
  },
  "rules": [
    {
      "id": "private.object.exclude",
      "class": "private",
      "objectClass": ["Person", "Family", "Event", "Place", "Source", "Citation", "Repository", "Media", "Note"],
      "path": "/private",
      "action": "exclude_object",
      "phase": "classify",
      "summary": "A primary object with private true is excluded. One that was synced before is withdrawn.",
      "source": "sync.md 5.1",
      "server": "detect"
    },
    {
      "id": "private.name.hold_person",
      "class": "private",
      "objectClass": ["Person"],
      "path": "/primary_name/private",
      "action": "exclude_object",
      "phase": "classify",
      "summary": "A person whose primary name is private is held whole: a person cannot exist in the cloud without a name.",
      "source": "sync.md 5.1",
      "server": "detect",
      "params": { "disposition": "hold" }
    },
    {
      "id": "private.element.alternate_names",
      "class": "private",
      "objectClass": ["Person"],
      "path": "/alternate_names/*",
      "action": "filter_element",
      "phase": "elements",
      "summary": "A private alternate name is removed from the list.",
      "source": "sync.md 5.1",
      "server": "detect",
      "params": { "when": "private" }
    },
    {
      "id": "private.element.event_ref_list",
      "class": "private",
      "objectClass": ["Person", "Family"],
      "path": "/event_ref_list/*",
      "action": "filter_element",
      "phase": "elements",
      "summary": "A private event reference is removed from the list.",
      "source": "sync.md 5.1",
      "server": "detect",
      "params": { "when": "private" }
    },
    {
      "id": "private.element.media_list",
      "class": "private",
      "objectClass": ["Person", "Family", "Event", "Place", "Source", "Citation"],
      "path": "/media_list/*",
      "action": "filter_element",
      "phase": "elements",
      "summary": "A private media reference is removed from the list.",
      "source": "sync.md 5.1",
      "server": "detect",
      "params": { "when": "private" }
    },
    {
      "id": "private.element.child_ref_list",
      "class": "private",
      "objectClass": ["Family"],
      "path": "/child_ref_list/*",
      "action": "filter_element",
      "phase": "elements",
      "summary": "A private child reference is removed from the list.",
      "source": "sync.md 5.1",
      "server": "detect",
      "params": { "when": "private" }
    },
    {
      "id": "private.element.attribute_list",
      "class": "private",
      "objectClass": ["Person", "Family", "Event", "Media"],
      "path": "/**/attribute_list/*",
      "action": "filter_element",
      "phase": "elements",
      "summary": "A private attribute is removed, on the object and on its event and media references.",
      "source": "sync.md 5.1",
      "server": "detect",
      "params": { "when": "private", "elementClass": "Attribute" }
    },
    {
      "id": "private.element.src_attribute_list",
      "class": "private",
      "objectClass": ["Source", "Citation"],
      "path": "/attribute_list/*",
      "action": "filter_element",
      "phase": "elements",
      "summary": "A private source attribute is removed from the list.",
      "source": "sync.md 5.1",
      "server": "detect",
      "params": { "when": "private", "elementClass": "SrcAttribute" }
    },
    {
      "id": "private.element.urls",
      "class": "private",
      "objectClass": ["Person", "Place", "Repository"],
      "path": "/urls/*",
      "action": "filter_element",
      "phase": "elements",
      "summary": "A private URL is removed from the list.",
      "source": "sync.md 5.1",
      "server": "detect",
      "params": { "when": "private" }
    },
    {
      "id": "private.element.address_list",
      "class": "private",
      "objectClass": ["Person", "Repository"],
      "path": "/address_list/*",
      "action": "filter_element",
      "phase": "elements",
      "summary": "A private address is removed from the list. The whole list is local-only anyway (contact.address_list).",
      "source": "sync.md 5.1",
      "server": "detect",
      "params": { "when": "private" }
    },
    {
      "id": "private.element.lds_ord_list",
      "class": "private",
      "objectClass": ["Person"],
      "path": "/lds_ord_list/*",
      "action": "filter_element",
      "phase": "elements",
      "summary": "A private LDS ordinance is removed from the list. The whole list is local-only anyway (birth.lds_ord).",
      "source": "sync.md 5.1",
      "server": "detect",
      "params": { "when": "private" }
    },
    {
      "id": "private.element.person_ref_list",
      "class": "private",
      "objectClass": ["Person"],
      "path": "/person_ref_list/*",
      "action": "filter_element",
      "phase": "elements",
      "summary": "A private association is removed from the list.",
      "source": "sync.md 5.1",
      "server": "detect",
      "params": { "when": "private" }
    },
    {
      "id": "private.element.reporef_list",
      "class": "private",
      "objectClass": ["Source"],
      "path": "/reporef_list/*",
      "action": "filter_element",
      "phase": "elements",
      "summary": "A private repository reference is removed from the list.",
      "source": "sync.md 5.1",
      "server": "detect",
      "params": { "when": "private" }
    },
    {
      "id": "private.orphan.exclude",
      "class": "private",
      "objectClass": ["Event", "Note", "Media", "Citation", "Family"],
      "path": "/",
      "action": "exclude_object",
      "phase": "orphans",
      "summary": "After the exclusions, an Event, Note, Media, Citation or Family that is referenced, and whose referrers are all excluded or held (or reach it only through a removed private element), is excluded too, repeatedly until nothing changes. Places, Sources and Repositories are exempt. Lift keeps the objects locally; a previously synced one becomes a withdraw (exclude_orphan_of_private).",
      "source": "BRD2 11.1, sync.md 5.1b",
      "server": "none",
      "params": { "exempt": ["Place", "Source", "Repository"], "fixpoint": true }
    },
    {
      "id": "private.citation.source_excluded",
      "class": "private",
      "objectClass": ["Citation"],
      "path": "/source_handle",
      "action": "exclude_object",
      "phase": "orphans",
      "summary": "A Citation whose Source is excluded or held is excluded too, repeatedly with private.orphan.exclude: a citation cannot exist without its source. This task's reading of sync.md 5.1, which lists no filter for source_handle.",
      "source": "sync.md 5.1 (reading recorded by HFY-TSK-230)",
      "server": "none",
      "params": { "fixpoint": true }
    },
    {
      "id": "private.reference.handle_lists",
      "class": "private",
      "objectClass": ["*"],
      "path": "/**/{family_list,parent_family_list,note_list,citation_list}/*",
      "action": "filter_element",
      "phase": "references",
      "summary": "A reference to an excluded or held object is removed from the list.",
      "source": "sync.md 5.1",
      "server": "none"
    },
    {
      "id": "private.reference.element_refs",
      "class": "private",
      "objectClass": ["*"],
      "path": "/{event_ref_list,media_list,child_ref_list,person_ref_list,reporef_list}/*/ref",
      "action": "filter_element",
      "phase": "references",
      "summary": "An element whose reference points at an excluded or held object is removed from its list.",
      "source": "sync.md 5.1",
      "server": "none"
    },
    {
      "id": "private.reference.parent_handles",
      "class": "private",
      "objectClass": ["Family"],
      "path": "/{father_handle,mother_handle}",
      "action": "filter_element",
      "phase": "references",
      "summary": "A father or mother handle that points at an excluded or held person is set to null.",
      "source": "sync.md 5.1",
      "server": "none",
      "params": { "replaceWith": null }
    },
    {
      "id": "private.reference.placeref_list",
      "class": "private",
      "objectClass": ["Place"],
      "path": "/placeref_list/*/ref",
      "action": "filter_element",
      "phase": "references",
      "summary": "A parent place that is private or held is removed from placeref_list (a place under it becomes a top-level place).",
      "source": "sync.md 5.1",
      "server": "none"
    },
    {
      "id": "private.reference.event_place",
      "class": "private",
      "objectClass": ["Event"],
      "path": "/place",
      "action": "filter_element",
      "phase": "references",
      "summary": "An event place that is private or held is set to the empty string. This task's reading: the design lists placeref_list but not Event.place, and a private place must not be named by an event.",
      "source": "sync.md 5.1 (reading recorded by HFY-TSK-230)",
      "server": "none",
      "params": { "replaceWith": "" }
    },
    {
      "id": "birth.date.daymonth",
      "class": "birth",
      "objectClass": ["Event"],
      "path": "/date/dateval/{0,1,4,5}",
      "action": "reduce_date",
      "phase": "fields",
      "summary": "A birth-like event carries no day and no month, in either half of a RANGE or SPAN, for anyone.",
      "source": "sync.md 5.2, BRD2 11.1, D2-32",
      "server": "detect",
      "params": { "when": "birthLike", "value": 0 }
    },
    {
      "id": "birth.date.text",
      "class": "birth",
      "objectClass": ["Event"],
      "path": "/date/text",
      "action": "reduce_date",
      "phase": "fields",
      "summary": "The text of a birth-like date is the empty string. The server accepts only a bare year or nothing.",
      "source": "sync.md 5.2, D2-32",
      "server": "detect",
      "params": { "when": "birthLike", "value": "" }
    },
    {
      "id": "birth.date.textonly",
      "class": "birth",
      "objectClass": ["Event"],
      "path": "/date/modifier",
      "action": "reduce_date",
      "phase": "fields",
      "summary": "A TEXTONLY birth-like date becomes a plain date with the first four-digit year of its text, or an empty date when the text has none.",
      "source": "sync.md 5.2, PS-01",
      "server": "detect",
      "params": { "when": "birthLike and modifier is TEXTONLY" }
    },
    {
      "id": "birth.date.sortval",
      "class": "birth",
      "objectClass": ["Event"],
      "path": "/date/sortval",
      "action": "reduce_date",
      "phase": "fields",
      "summary": "The sort value of a reduced date is recomputed as the day number of January 1 of its year (Gregorian and Julian), and 0 when the year is 0 or the calendar is another.",
      "source": "sync.md 5.2",
      "server": "none",
      "params": { "when": "the date was reduced", "derived": true }
    },
    {
      "id": "birth.citation.date",
      "class": "birth",
      "objectClass": ["Citation"],
      "path": "/date/dateval/{0,1,4,5}",
      "action": "reduce_date",
      "phase": "fields",
      "summary": "The date of a citation that a birth-like event or its event reference cites carries no day and no month, and no text.",
      "source": "BRD2 11.1, PS-03",
      "server": "detect",
      "params": { "when": "citation referenced by a birth-like event or its EventRef" }
    },
    {
      "id": "birth.name.date",
      "class": "birth",
      "objectClass": ["Person"],
      "path": "/{primary_name,alternate_names/*}/date/dateval/{0,1,4,5}",
      "action": "reduce_date",
      "phase": "fields",
      "summary": "The date of a name of type Birth carries no day and no month, and no text.",
      "source": "BRD2 11.1, PS-03",
      "server": "detect",
      "params": { "when": "name type is Birth" }
    },
    {
      "id": "birth.dob_exact.date",
      "class": "birth",
      "objectClass": ["*"],
      "path": "/**/date",
      "action": "reduce_date",
      "phase": "fields",
      "summary": "Any Date of any class (events, names, citations, media, attributes, other people's objects) that equals a full birth date held locally is reduced as if birth-like. Desktop only: the cloud never knows the local dates.",
      "source": "BRD2 11.1, PS-03, SI-16",
      "server": "none",
      "desktopOnly": true
    },
    {
      "id": "birth.sticky",
      "class": "birth",
      "objectClass": ["Event"],
      "path": "/date",
      "action": "reduce_date",
      "phase": "fields",
      "summary": "An event that was ever birth-like (birthlike_sticky) keeps day and month local, even after a retype or a birth_ref change, until io releases the handle in the GUI.",
      "source": "BRD2 11.1, PS-02",
      "server": "none",
      "desktopOnly": true
    },
    {
      "id": "birth.attribute.age_time",
      "class": "birth",
      "objectClass": ["Person", "Family", "Event", "Media"],
      "path": "/**/attribute_list/*",
      "action": "local_only",
      "phase": "fields",
      "summary": "Attributes of type AGE, FATHER_AGE, MOTHER_AGE and TIME are local-only, on persons, events and event references.",
      "source": "sync.md 5.2, PS-06",
      "server": "detect",
      "params": { "elementClass": "Attribute", "types": "attributes.ageAndTime" }
    },
    {
      "id": "birth.lds_ord",
      "class": "birth",
      "objectClass": ["Person"],
      "path": "/lds_ord_list",
      "action": "local_only",
      "phase": "fields",
      "summary": "The whole LDS ordinance list is local-only (ordinance dates include baptism).",
      "source": "sync.md 5.2, Q2-02 item 4",
      "server": "detect"
    },
    {
      "id": "contact.address_list",
      "class": "contact",
      "objectClass": ["Person", "Repository"],
      "path": "/address_list",
      "action": "local_only",
      "phase": "fields",
      "summary": "Every address (street, locality, city, county, state, country, postal code, phone, date, notes, citations) is local-only: the whole list.",
      "source": "sync.md 5.3, Q2-02 item 2",
      "server": "detect"
    },
    {
      "id": "contact.url.email_type",
      "class": "contact",
      "objectClass": ["Person", "Place", "Repository"],
      "path": "/urls/*",
      "action": "local_only",
      "phase": "fields",
      "summary": "A URL of type Email is local-only.",
      "source": "sync.md 5.3",
      "server": "detect",
      "params": { "when": "type is Email" }
    },
    {
      "id": "contact.url.channel",
      "class": "contact",
      "objectClass": ["Person", "Place", "Repository"],
      "path": "/urls/*",
      "action": "local_only",
      "phase": "fields",
      "summary": "A URL with a contact-channel scheme, a contact-channel host (or a subdomain of one) or a contact-channel path is local-only.",
      "source": "sync.md 5.3",
      "server": "detect",
      "params": { "when": "urls.schemes, urls.hosts or urls.paths match" }
    },
    {
      "id": "contact.url.scan_hit",
      "class": "contact",
      "objectClass": ["Person", "Place", "Repository"],
      "path": "/urls/*",
      "action": "local_only",
      "phase": "fields",
      "summary": "A URL whose path or description has a scanner hit is local-only.",
      "source": "sync.md 5.3",
      "server": "detect",
      "params": { "when": "the shared detector finds a phone, email, street address, PO box, contact URL or date of birth in path or desc" }
    },
    {
      "id": "contact.alt_loc.fields",
      "class": "contact",
      "objectClass": ["Place"],
      "path": "/alt_loc/*/{street,locality,postal,phone}",
      "action": "local_only",
      "phase": "fields",
      "summary": "The street, locality, postal code and phone of an alternate location are blanked.",
      "source": "sync.md 5.3, Q2-02 item 2",
      "server": "detect"
    },
    {
      "id": "contact.alt_loc.empty",
      "class": "contact",
      "objectClass": ["Place"],
      "path": "/alt_loc/*",
      "action": "filter_element",
      "phase": "fields",
      "summary": "An alternate location left with no non-empty field after the blanking is removed.",
      "source": "sync.md 5.3",
      "server": "none"
    },
    {
      "id": "contact.attribute.government_id",
      "class": "contact",
      "objectClass": ["Person", "Family", "Event", "Media"],
      "path": "/**/attribute_list/*",
      "action": "local_only",
      "phase": "fields",
      "summary": "Attributes of type SSN and ID (government identifiers) are local-only.",
      "source": "sync.md 5.3, Q2-02 item 4",
      "server": "detect",
      "params": { "elementClass": "Attribute", "types": "attributes.governmentId" }
    },
    {
      "id": "contact.researcher",
      "class": "contact",
      "objectClass": ["Researcher"],
      "path": "/",
      "action": "exclude_object",
      "phase": "classify",
      "summary": "Researcher metadata (the database owner's name, address, phone and e-mail) is never read by the addon: a Researcher object is never projected.",
      "source": "sync.md 5.3",
      "server": "none"
    },
    {
      "id": "place.exclude.type",
      "class": "place",
      "objectClass": ["Place"],
      "path": "/place_type/value",
      "action": "exclude_object",
      "phase": "classify",
      "summary": "A place of type Street, Farm, Building or Number is excluded. References to it are re-pointed (place.repoint).",
      "source": "sync.md 5.3, BRD2 11.1, PS-15",
      "server": "detect",
      "params": { "types": "places.excludedTypes" }
    },
    {
      "id": "place.exclude.custom_home_like",
      "class": "place",
      "objectClass": ["Place"],
      "path": "/place_type/string",
      "action": "exclude_object",
      "phase": "classify",
      "summary": "A place of Custom type whose type name matches the home-like pattern (a substring match, case-insensitive) is excluded. References to it are re-pointed.",
      "source": "BRD2 11.1, PS-15",
      "server": "detect",
      "params": { "pattern": "places.customHomeLike" }
    },
    {
      "id": "place.repoint",
      "class": "place",
      "objectClass": ["Event", "Place"],
      "path": "/{place,placeref_list/*/ref}",
      "action": "repoint_place",
      "phase": "references",
      "summary": "A reference to a place excluded by type is re-pointed to its nearest kept ancestor through placeref_list[0], or to the empty string (event) or removed (placeref_list) when there is none.",
      "source": "sync.md 5.3",
      "server": "detect"
    },
    {
