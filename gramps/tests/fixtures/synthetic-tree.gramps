        <range start="27" end="35"/>
      </style>
    </note>
    <note handle="_0e6733cba0dd33c89301ca941baa" change="1700000000" id="N0002" type="Person Note">
      <text>For questions call 555-0142 in the evening.</text>
    </note>
    <note handle="_1ab65fd1a669b8d8807541eead80" change="1700000000" id="N0004" type="Person Note">
      <text>A plain note with nothing sensitive in it.</text>
    </note>
    <note handle="_2ddfd20610d11bd5d4043753b0e9" change="1700000000" id="N0010" type="Person Note">
      <text>The family Bible lists 12/25/1960 beside her name.</text>
    </note>
    <note handle="_afc0588c157693713513bfbfb862" change="1700000000" id="N0008" priv="1" type="Person Note">
      <text>A private note on an otherwise shared person.</text>
    </note>
    <note handle="_b519687fc092865e77651955c046" change="1700000000" id="N0006" type="Person Note">
      <text>Born on 3 May 1900 according to the register (fictional).</text>
    </note>
    <note handle="_c72f133b179c057ede7e73d3fb74" change="1700000000" id="N0007" priv="1" type="Person Note">
      <text>A private note that only the private person carries.</text>
    </note>
    <note handle="_d1ce89b0c30252ff079b201dda5e" change="1700000000" id="N0003" type="Person Note">
      <text>Write to fixture.contact@example.org with any news.</text>
    </note>
    <note handle="_e8d78d6fa203fe8541d0347ad59b" change="1700000000" id="N0005" type="Person Note">
      <text>The cottage was at 456 Sample Road, Exampleville.</text>
    </note>
    <note handle="_ee3650d2854ac6122ee5937b4b3c" change="1700000000" id="N0009" type="Person Note">
      <text>Letters went to P.O. Box 0100, Exampleville.</text>
    </note>
  </notes>
