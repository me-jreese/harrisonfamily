  <notes>
    <note handle="_021482b303418ebb656dd1bb870b" change="1700000000" id="N0001" type="Person Note">
      <text>Bold start, italic middle, link end.</text>
      <style name="bold" value="True">
        <range start="0" end="10"/>
      </style>
      <style name="italic" value="True">
